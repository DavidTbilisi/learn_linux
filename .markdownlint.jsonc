// Lenient config tuned for a Georgian-language learning resource where
// the priority is readable prose and runnable code blocks, not strict
// style uniformity.
{
  "default": true,

  // Line length — prose paragraphs and table rows shouldn't be wrapped.
  "MD013": false,

  // Inline HTML — used for tables, badges, and emoji-prefixed anchors.
  "MD033": false,

  // First line H1 — README has badges before the H1; mdBook SUMMARY.md
  // uses sections; some shorter files start with code or quotes.
  "MD041": false,

  // Duplicate heading siblings — chmod and other commands legitimately
  // repeat as section titles within different files. "siblings_only"
  // still catches the real bugs inside one file.
  "MD024": { "siblings_only": true },

  // Heading-level jumps (h2 → h4 etc.) — accepted in this content
  // (some pages use ### immediately after a # for compact intros).
  "MD001": false,

  // Blanks around headings/lists/fences — turned off because the
  // existing prose-tight style packs TOC and explanations against
  // the headings on purpose.
  "MD022": false,
  "MD031": false,
  "MD032": false,

  // Allow either - or * for list bullets.
  "MD004": false,

  // Multiple consecutive blank lines — harmless for readability.
  "MD012": false,

  // Trailing newline — some files generated without it.
  "MD047": false,

  // Spaces inside code spans — Georgian text + inline code interaction
  // produces false positives.
  "MD038": false,

  // Multiple H1s — mdBook SUMMARY.md REQUIRES them (section dividers).
  "MD025": false,

  // Fenced code block language tag — relaxed; some blocks are output
  // samples or example structure where a language tag is misleading.
  "MD040": false,

  // Link fragment validity — disabled because Georgian heading slugs
  // generated by various renderers (GitHub vs mdBook vs markdownlint)
  // don't agree, and the links work in practice.
  "MD051": false
}
